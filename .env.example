# ── Noble Trader Agent Backend ──────────────────────────────────────────────
# For Render deployment, set these in the Render dashboard Environment tab.
# For local dev, copy this to .env and fill in values.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Required for production.
# Dev fallback: http://localhost:3000
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app
CORS_ORIGINS=

# ── Auth ────────────────────────────────────────────────────────────────────
# Authentication mode: full | api_key_only | disabled
#   - full: JWT + API Keys + Clerk (default)
#   - api_key_only: Only API keys (recommended for LightningAI)
#   - disabled: No authentication (development only)
AUTH_MODE=full

# JWT Configuration (only used when AUTH_MODE=full)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINS=60

# API Keys (used in all modes except disabled)
# Format: comma-separated keys, or nt_live_* for SaaS DB-backed keys
API_KEYS=
# Example: API_KEYS=service_key_1,service_key_2,nt_live_abc123def456

# In-memory user store (legacy - only used with AUTH_ENABLED=true in v1.x)
# Format: "username:password:role,username2:password2:role2"
AUTH_USERS=

# ── Clerk ───────────────────────────────────────────────────────────────────
# Get from Clerk Dashboard → API Keys
# CLERK_PUBLISHABLE_KEY is NOT used by the backend (frontend-only).
# The backend needs CLERK_SECRET_KEY for JWT verification and REST API access.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# ── Alpaca Trading API ─────────────────────────────────────────────────────
# Paper trading by default — change base URL for live trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Binance ─────────────────────────────────────────────────────────────────
# Set to true for testnet WebSocket
BINANCE_TESTNET=false

# ── Interactive Brokers ─────────────────────────────────────────────────────
# TWS must be running with API enabled
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# ── Hyperliquid (L2 Order Book / Crypto Perps) ─────────────────────────────
# Defaults to Hyperliquid mainnet. No API key required for L2 WebSocket.
HL_API_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid.xyz/ws

# ── Discord Webhooks (Notifications) ───────────────────────────────────────
# Create webhooks in your Discord server: Settings → Integrations → Webhooks
DISCORD_WEBHOOK_SIGNALS=
DISCORD_WEBHOOK_EXECUTIONS=
DISCORD_WEBHOOK_STATUS=
# Debug webhook — used by scripts/debug_signal_subscriber.py to forward
# ALL signals (qualified AND rejected) to a debug Discord channel. Only
# active when DEBUG_SIGNALS=1 is set on the orchestrator AND the debug
# subscriber script is running.
# NOTE: This must NOT be commented out (no # prefix) if you want it loaded.
# Leave the value empty (as below) to disable, or paste your webhook URL.
DISCORD_WEBHOOK_DEBUG=

# ── Telegram Bot (Notifications) ──────────────────────────────────────────
# Create a bot via @BotFather, get the chat ID by messaging the bot and
# visiting https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Supabase (REQUIRED for runtime_config + pipeline persistence) ──────────
# Both values are from Supabase Dashboard → Project Settings → API.
#
# SUPABASE_URL: The project URL (e.g. https://pcvscowltlrxzgxjurcr.supabase.co)
# SUPABASE_KEY: The **service_role** key (NOT the anon/publishable key).
#   - The service role key is required because the backend reads/writes
#     nt_system_config, ta_renko_snapshot, api_keys, nt_system_config_audit,
#     nt_calibration_records, and rate_limit_violations tables.
#   - The anon/publishable key is for frontend-only use and does NOT have
#     sufficient permissions for backend operations.
#   - On Render, these must both be set or the /renko/health endpoint will
#     report "SUPABASE_URL/KEY not configured" and runtime_config will
#     fall back to env vars + hardcoded defaults.
#
# ⚠️  IMPORTANT: There is NO "SUPABASE_PUBLISHABLE_KEY" env var in the backend.
#     The backend uses SUPABASE_KEY (service role). The frontend uses
#     NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_KEY=

# ── Redis (optional — for pipeline state persistence) ──────────────────────
# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# Lightning & TIMESFM
LIGHTNING_APIKEY=
LIGHTNING_USER_ID=
LIGHTNING_URL=
TIMESFM_INFERENCE_URL=
TIMESFM_API_KEYS=
# Optional: override the direct-to-TimesFM URL used as a fallback when
# the gateway (port 8000) is unreachable. Default: http://127.0.0.1:8002/forecast
# TIMESFM_DIRECT_URL=http://127.0.0.1:8002/forecast
# Optional: disable the direct-port fallback (only use the gateway URL)
# TIMESFM_DISABLE_FALLBACK=0
# Optional: how long (seconds) start.sh / on_start.sh / background.py
# waits for the TimesFM model to finish loading before starting the
# sweep orchestrator anyway. Default: 180s. First-ever run may need 300s+
# (HuggingFace weight download). Subsequent runs: 30-60s.
# TIMESFM_READY_TIMEOUT=180

# ── Signal Qualification Thresholds ─────────────────────────────────────
# These control which sweep signals get published to Redis pub/sub
# "signal.raw.noble_trader" and forwarded to Discord. Tune to control
# signal volume vs. quality.
#
# Gate 1: signal must be "buy" or "sell" (not "neutral") — not configurable
# Gate 2: HMM regime confidence must be >= this (default: 0.60)
# MIN_REGIME_CONF=0.60
# Gate 3: Kelly fraction must be >= this (default: 0.02 = 2%)
# MIN_KELLY=0.02
# Gate 4: TimesFM must be available (p_timesfm is not None) — not configurable
# Gate 5: TimesFM confidence |p - 0.5| must be >= this (default: 0.05 = 5%)
# MIN_TIMESFM_CONFIDENCE=0.05
# Gate 6: EV engine allow/deny — EV must be > MIN_EV AND RR must be >= MIN_RR
#   EV = (p_win * profit) - ((1 - p_win) * stake)
#   RR = tp_bricks / sl_bricks (default bricks: 5/3 = 1.67)
#   ⚠ With default brick params (sl=3, tp=5), RR=1.67 < 2.0 → ALL signals
#     are rejected by Gate 6. Either lower MIN_RR to 1.5, or increase
#     tp_bricks to 6+ in Redis config per symbol.
# MIN_EV=0.0
# MIN_RR=2.0
#
# When True (DEBUG_SIGNALS=1), publish ALL signals (even rejected ones)
# to Redis channel "signal.debug.noble_trader" for diagnostic visibility.
# Use scripts/debug_signal_subscriber.py to listen and inspect.
# DEBUG_SIGNALS=0
