# ── Noble Trader Agent Backend ──────────────────────────────────────────────
# For Render deployment, set these in the Render dashboard Environment tab.
# For local dev, copy this to .env and fill in values.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000

# ── Alpaca Trading API ─────────────────────────────────────────────────────
# Paper trading by default — change base URL for live trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Discord Webhooks (Notifications) ───────────────────────────────────────
# Create webhooks in your Discord server: Settings → Integrations → Webhooks
DISCORD_WEBHOOK_SIGNALS=
DISCORD_WEBHOOK_EXECUTIONS=
DISCORD_WEBHOOK_STATUS=

# ── Redis (optional — for pipeline state persistence) ──────────────────────
REDIS_URL=

# ── Auth (JWT + Clerk) ────────────────────────────────────────────────────
# JWT_SECRET_KEY is required for authentication. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINS=60

# ── Clerk Authentication ─────────────────────────────────────────────────
# Get from Clerk Dashboard → API Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no wildcards in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000
