# ── Noble Trader (Kairos) backend — environment template ─────────────────────
# Copy to .env and fill in. Two kinds of settings, kept strictly apart:
#
#   SECRETS → LightningAI Studio Secrets (Settings → Environment → Secrets)
#             or the Render dashboard Environment tab. Never commit.
#   KNOBS   → config/feature_flags.yaml (git-tracked, hot-reloads on mtime).
#             regime_platform/core/feature_flags.py does NOT read any env var
#             for these — a Studio Secret with a matching name has ZERO effect.
#
# This file lists SECRETS plus the few knobs that are still genuinely env-read.
# Everything that moved to config/* is in the pointer table near the bottom,
# NOT as a variable here.
#
# Last audited against the code: 2026-10-20 (Studio key rotation).

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
# Max log file size in KB before truncation (background.py). Default: 10240 (10 MB).
# LOG_MAX_KB=10240

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Required for production.
# NOTE: the live middleware (main.py) reads CORS_ALLOWED_ORIGINS, NOT CORS_ORIGINS.
# Dev fallback when unset: http://localhost:3000
CORS_ALLOWED_ORIGINS=

# ── Auth ────────────────────────────────────────────────────────────────────
# 2026-08-25: single shared-secret gatekeeping (no live users, single deployment
# — JWT/Clerk/per-user roles retired). Every protected endpoint checks this same
# X-API-Key header value. Empty means the gate fails closed: nothing authenticates.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=

# MCP_INTERNAL_KEY / AUTH_MODE / AUTH_ENABLED / JWT_SECRET_KEY / CLERK_* appeared
# in earlier revisions of this file but have NO consumer in this repo
# (regime_platform/auth/ contains only api_key.py, which reads settings.API_KEY).
# They are inert — do not add them to Studio Secrets.

# ── Supabase (REQUIRED for runtime_config + pipeline persistence) ──────────
# Both from Supabase Dashboard → Project Settings → API.
#
# SUPABASE_URL: the project URL (e.g. https://pcvscowltlrxzgxjurcr.supabase.co)
# SUPABASE_SECRET_KEY: the **secret** key — Supabase's post-2026-10 name for the
#   service_role key (NOT the anon/publishable key).
#   - Required because the backend reads/writes nt_system_config, nt_renko_snapshot,
#     api_keys, nt_system_config_audit, nt_calibration_records, rate_limit_violations.
#   - The publishable/anon key is frontend-only and lacks the permissions.
#   - Both must be set or /renko/health reports "SUPABASE_URL/KEY not configured"
#     and runtime_config falls back to env vars + hardcoded defaults.
#
# ⚠️  There is NO SUPABASE_PUBLISHABLE_KEY var on the backend. The frontend uses
#     NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
#
# ROTATION 2026-10-20: SUPABASE_SECRET_KEY is canonical. The pre-rotation
# SUPABASE_KEY / SUPABASE_SERVICE_ROLE are accepted as deprecated aliases
# (settings.py AliasChoices) so an existing Secret keeps working — set the new
# name and delete the old ones.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Cloudflare Worker (embeddings + Clef-Flash decisions) ──────────────────
# The Worker lives in cloudflare/worker.js, deployed with `npx wrangler deploy`.
#
# CF_API_TOKEN      — Cloudflare API token. Worker secret:
#                     npx wrangler secret put CF_API_TOKEN
#                   Fallback only: the preferred path is the [[ai]] binding in
#                   wrangler.toml, which needs no token.
# CF_WORKER_SECRET  — optional shared secret; when set, callers must send a
#                     matching x-worker-secret header. Worker secret:
#                     npx wrangler secret put CF_WORKER_SECRET
# CF_EMBEDDINGS_URL — the Worker's public URL, read by the BACKEND
#                     (clef_flash.py / knowledge_index.py). Studio Secret.
#
# ROTATION 2026-10-20: all three were regenerated. CF_API_TOKEN and
# CF_WORKER_SECRET live in Cloudflare, not in Studio Secrets.
CF_API_TOKEN=
CF_WORKER_SECRET=
CF_EMBEDDINGS_URL=

# ── TimesFM forecast service ───────────────────────────────────────────────
# Comma-separated API keys for /forecast (server.py). A missing value makes
# server.py log a warning and generate a throwaway dev key.
TIMESFM_API_KEYS=
TIMESFM_INFERENCE_URL=
# Optional: override the direct-to-TimesFM URL used as a fallback when the
# gateway (port 8000) is unreachable. Default: http://127.0.0.1:8002/forecast
# TIMESFM_DIRECT_URL=http://127.0.0.1:8002/forecast
#
# INFRA, not a trading knob: how long (seconds) start.sh / on_start.sh /
# background.py waits for the TimesFM model to load before starting the
# orchestrator anyway. Default: 180s. First-ever run may need 300s+
# (HuggingFace weight download).
#
# This is the ONE TimesFM value that deliberately REMAINS an env var: it is
# read by the shell launch scripts and the Dockerfile (shell has no YAML
# parser), so it cannot move into config/feature_flags.yaml. Every other
# TimesFM knob (model_id / max_context / max_horizon / disable_fallback) did
# move — see the pointer table below.
# TIMESFM_READY_TIMEOUT=180
# Require TimesFM to be available for a signal to pass — makes a TimesFM outage
# FATAL at startup. Read by orchestrator.py. Default: 0.
# TIMESFM_REQUIRED=0

# ── Price data (TradingView via RapidAPI — the sole production price path) ──
# Sign up at https://rapidapi.com/ and subscribe to the TradingView API.
# Plan: Ultra (100k requests/month)
TRADINGVIEW_API_KEY=
TRADINGVIEW_API_HOST=tradingview-data1.p.rapidapi.com
TRADINGVIEW_BASE_URL=https://tradingview-data1.p.rapidapi.com

# ── Discord webhooks (notifications) ───────────────────────────────────────
# Create webhooks in your Discord server: Settings → Integrations → Webhooks
DISCORD_WEBHOOK_SIGNALS=
DISCORD_WEBHOOK_EXECUTIONS=
DISCORD_WEBHOOK_STATUS=
# Per-asset-class routing (optional). Leave empty to send everything to
# DISCORD_WEBHOOK_SIGNALS. crypto / equities / metals / forex channels.
DISCORD_WEBHOOK_CRYPTO=
DISCORD_WEBHOOK_EQUITIES=
DISCORD_WEBHOOK_METALS=
DISCORD_WEBHOOK_FOREX=

# ── Telegram bot (notifications) ───────────────────────────────────────────
# Create a bot via @BotFather, get the chat ID from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trading / market data ──────────────────────────────────────────────────
# Paper trading by default — change base URL for live trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Set to true for the Binance testnet WebSocket
BINANCE_TESTNET=false
# Interactive Brokers — TWS must be running with the API enabled
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
# Hyperliquid L2 order book. No API key required for the L2 WebSocket.
# NOTE: HL_WS_URL is the LIVE consumer (adapters/l2_adapters.py). HL_API_URL is a
# declared settings field with NO current code consumer — kept for compatibility.
HL_API_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid.xyz/ws

# ── Deployment environment ──────────────────────────────────────────────────
# production | staging | development. MUST be set explicitly in every real
# deployment. When "production" or "staging": a CORS wildcard ("*") is FATAL
# (startup refuses to boot) and 500s are not echoed to clients.
# Ref: main.py (os.getenv("DEPLOY_ENV", os.getenv("NODE_ENV", "development")))
DEPLOY_ENV=production

# ── Service URLs / ports (internal wiring) ──────────────────────────────────
# Base URL of THIS backend service (proxy.py; self-links / callback assembly).
# MAIN_URL=http://localhost:8000
# TimesFM inference service URL. Falls back to the gateway (port 8000) when
# unreachable if TIMESFM_DISABLE_FALLBACK is unset.
# TIMESFM_SERVICE_URL=http://127.0.0.1:8002/forecast
# Port the sweep orchestrator's health-check endpoint listens on. Default 8003.
# SWEEP_ORCHESTRATOR_PORT=8003
# TTL (seconds) for cached runtime_config lookups from Supabase.
# RUNTIME_CONFIG_TTL=60

# ── Paper book (M4) ─────────────────────────────────────────────────────────
# Max age in days for an open paper position before the reconcile close pass
# force-expires it at $0. Default: 7 (paper_book.py — was documented as 30).
# NOBLE_PAPER_OPEN_MAX_AGE_DAYS=7
# Base notional used by the paper book Kelly sizing. Default: 1000.
# NOBLE_PAPER_BASE_NOTIONAL=1000

# ── Markov regime tuning ───────────────────────────────────────────────────
# The ACTUAL env vars consumed by orchestrator.py (the old documented
# MARKOV_ALPHA/BETA/GAMMA/DELTA had zero consumers and were removed):
# Window over which regime features are computed (days). Default: 7
# MARKOV_WINDOW_DAYS=7
# Bars per day in the Markov window (24h 1-bar → 24). Default: 24
# MARKOV_BARS_PER_DAY=24
# Explicit window override in bars (defaults to WINDOW_DAYS × BARS_PER_DAY = 168).
# MARKOV_WINDOW_BARS=168
# Hold steps used by the EV engine when simulating TP/SL paths. Default: 10
# MARKOV_HOLD_STEPS=10

# ── EOD calibration raw-bias thresholds (4h intraday correction) ───────────
# Used ONLY by the 4h intraday correction pass (run_eod_correction(raw_bias_mode=True)).
# These are still read straight from env (settings.py), NOT from config/*.
#
# bias >= 0.30 → OVERCONFIDENT (raw model systematically above true win rate)
# bias <= -0.20 → UNDERCONFIDENT (raw model systematically below)
# -0.20 < bias < 0.30 → CALIBRATED
# EOD_BIAS_RAW_OVERCONFIDENT=0.30
# EOD_BIAS_RAW_UNDERCONFIDENT=-0.20

# ── Moved to config/* — DO NOT set these as env vars ────────────────────────
# regime_platform/core/feature_flags.py is the sole source of truth for these.
# A Studio Secret or .env entry with the same name has ZERO effect (this is the
# exact MIN_RR-incident shape — see AGENTS.md). Edit config/feature_flags.yaml.
#
#   old env var                     →  config key
#   ---------------------------------+--------------------------------------
#   MIN_REGIME_CONF                 →  qualification_gates.min_regime_conf
#   MIN_TIMESFM_CONFIDENCE          →  qualification_gates.min_timesfm_confidence
#   MIN_EV                          →  qualification_gates.min_ev
#   MIN_P_WIN                       →  qualification_gates.min_p_win
#   MIN_RR                          →  min_rr
#   TIMESFM_GATE_MODE               →  timesfm_gate_mode
#   SWEEP_AFTER_HOURS               →  sweep_after_hours
#   SIGNAL_COOLDOWN_MINUTES         →  signal_cooldown_minutes
#   MARKOV_SOURCE_MODE              →  markov_source_mode
#   TIMESFM_SIGMOID_K               →  timesfm.sigmoid_k
#   TIMESFM_CLAMP_MIN               →  timesfm.clamp_min
#   TIMESFM_CLAMP_MAX               →  timesfm.clamp_max
#   HEAVY_SWEEP_MAX_SHARPE          →  heavy_sweep_grid.max_sharpe
#   HEAVY_SWEEP_MIN_TRADES          →  heavy_sweep_grid.min_trades
#
#   ── 2026-10-20 migration (Studio key rotation) ──────────────────────────
#   These nine were env-overridable settings fields or os.getenv calls. Env
#   no longer has any effect; a leftover Secret with these names is inert.
#   EOD_CORRECTION_INTRADAY_ENABLED →  eod_correction.intraday_enabled
#   EOD_CORRECTION_INTERVAL_HOURS   →  eod_correction.interval_hours
#   EOD_BIAS_WINDOW_DAYS            →  eod_bias.window_days
#   EOD_BIAS_MIN_RECORDS            →  eod_bias.min_records
#   EOD_DRIFT_MONITOR_ENABLED       →  eod_drift_monitor.enabled
#   TIMESFM_MODEL_ID                →  timesfm_service.model_id
#   TIMESFM_MAX_CONTEXT             →  timesfm_service.max_context
#   TIMESFM_MAX_HORIZON             →  timesfm_service.max_horizon
#   TIMESFM_DISABLE_FALLBACK        →  timesfm_service.disable_fallback
#   (TIMESFM_MODEL_REVISION had NO code consumer at all — dropped entirely.)
#
# MIN_KELLY → qualification_gates.min_kelly — NOTE: the Kelly GATE was REMOVED
# 2026-09-27 (it zeroed 61% of directional scans). The key remains in config but
# Kelly is sizing research, never a gate. Do not re-add a MIN_KELLY gate.
#
# DISABLE_YAHOO_FALLBACK, LIGHTNING_APIKEY, LIGHTNING_USER_ID, LIGHTNING_URL —
# deprecated, no code consumer (verified 2026-08-12 audit M6, re-verified
# 2026-10-20). Left out of this file entirely.

# ── Studio Secrets checklist (the minimal set) ──────────────────────────────
# Set these in the Studio UI (Settings → Environment → Secrets). .env.local is
# NOT read by the Studio runtime — only local dev uses it.
#
# REQUIRED for the sweep to persist anything:
#   SUPABASE_URL, SUPABASE_SECRET_KEY
# REQUIRED for any authenticated endpoint to answer:
#   API_KEY
# REQUIRED for the TimesFM forecast service to authenticate:
#   TIMESFM_API_KEYS
# Rotated 2026-10-20:
#   CF_API_TOKEN, CF_WORKER_SECRET (Cloudflare Worker secrets, not Studio)
#   CF_EMBEDDINGS_URL
# Everything else in this file is optional — unset means the documented default.
#
# Do NOT put MIN_* / TIMESFM_* / EOD_* / HEAVY_SWEEP_* / MARKOV_SOURCE_MODE /
# SIGNAL_COOLDOWN_MINUTES / SWEEP_AFTER_HOURS in Studio Secrets. They are inert
# there and the real values live in config/feature_flags.yaml.
#
# The ONLY TimesFM value that is still a legitimate env var is
# TIMESFM_READY_TIMEOUT (shell/Docker launch path — see the TimesFM section).
