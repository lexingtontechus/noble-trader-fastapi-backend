# ── Noble Trader Agent Backend ──────────────────────────────────────────────
# For Render deployment, set these in the Render dashboard Environment tab.
# For local dev, copy this to .env and fill in values.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Required for production.
# NOTE: the live middleware (main.py) reads CORS_ALLOWED_ORIGINS, NOT CORS_ORIGINS.
# Dev fallback when unset: http://localhost:3000
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app
CORS_ALLOWED_ORIGINS=

# ── Auth ────────────────────────────────────────────────────────────────────
# Authentication mode: full | api_key_only | disabled
#   - full: JWT + API Keys + Clerk (default)
#   - api_key_only: Only API keys (recommended for LightningAI)
#   - disabled: No authentication (development only)
AUTH_MODE=full

# ⚠️ SECURITY: Master auth kill-switch. Default "true". Set to "false" ONLY for
# local development — this disables ALL authentication on every endpoint
# (JWT, API keys, Clerk). Never set false in production/staging.
# Ref: regime_platform/auth/auth_config.py (os.getenv("AUTH_ENABLED", "true"))
AUTH_ENABLED=true

# ⚠️ SECRET — MCP internal service-to-service ADMIN key.
# Presenting this value as an X-API-Key / ?api_key= grants role="admin"
# (subject "mcp-internal") in EVERY auth path (api_key_only, full REST + JWT
# mint/validate, and WebSocket). It is the ONLY non-API_KEYS credential that
# escalates to admin. It is read via os.getenv("MCP_INTERNAL_KEY") with NO
# default — if unset, the internal-admin path is simply unavailable.
# Generate a strong random value; do NOT reuse example strings like
# "mcp-service-key" in any real deployment (anyone who knows it gets admin).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_INTERNAL_KEY=

# JWT Configuration (only used when AUTH_MODE=full)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINS=60

# API Keys (used in all modes except disabled)
# Format: comma-separated keys, or nt_live_* for SaaS DB-backed keys
API_KEYS=
# Example: API_KEYS=service_key_1,service_key_2,nt_live_abc123def456

# In-memory user store (legacy - only used with AUTH_ENABLED=true in v1.x)
# Format: "username:password:role,username2:password2:role2"
AUTH_USERS=

# ── Clerk ───────────────────────────────────────────────────────────────────
# Get from Clerk Dashboard → API Keys
# CLERK_PUBLISHABLE_KEY is NOT used by the backend (frontend-only).
# The backend needs CLERK_SECRET_KEY for JWT verification and REST API access.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# ── Alpaca Trading API ─────────────────────────────────────────────────────
# Paper trading by default — change base URL for live trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Binance ─────────────────────────────────────────────────────────────────
# Set to true for testnet WebSocket
BINANCE_TESTNET=false

# ── Interactive Brokers ─────────────────────────────────────────────────────
# TWS must be running with API enabled
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# ── Hyperliquid (L2 Order Book / Crypto Perps) ─────────────────────────────
# Defaults to Hyperliquid mainnet. No API key required for L2 WebSocket.
# NOTE: HL_WS_URL is the LIVE consumer (adapters/l2_adapters.py).
# HL_API_URL is a declared settings field with NO current code consumer —
# kept for compatibility, do not rely on it.
HL_API_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid.xyz/ws

# ── TradingView (RapidAPI — Price Data) ────────────────────────────────────
# TradingView API via RapidAPI provides OHLCV candle data for crypto,
# forex, stocks, commodities, and more.
# Sign up at https://rapidapi.com/ and subscribe to the TradingView API.
# Plan: Ultra (100k requests/month)
TRADINGVIEW_API_KEY=
TRADINGVIEW_API_HOST=tradingview-data1.p.rapidapi.com
TRADINGVIEW_BASE_URL=https://tradingview-data1.p.rapidapi.com
# Set to 1 to disable the Yahoo/yfinance fallback. Yahoo is data-only (no
# real exchange), so signals based on Yahoo data can't be executed. If all
# your active symbols use tradingview/alpaca/hyperliquid, set this to 1.
# DEPRECATED — no code consumer (verified 2026-08-12 audit M6). Kept only
# so existing env files don't break; the flag has no effect.
# DISABLE_YAHOO_FALLBACK=0

# ── Discord Webhooks (Notifications) ───────────────────────────────────────
# Create webhooks in your Discord server: Settings → Integrations → Webhooks
DISCORD_WEBHOOK_SIGNALS=
DISCORD_WEBHOOK_EXECUTIONS=
DISCORD_WEBHOOK_STATUS=
# Debug webhook — used by scripts/debug_signal_subscriber.py to forward
# ALL signals (qualified AND rejected) to a debug Discord channel. Only
# active when DEBUG_SIGNALS=1 is set on the orchestrator AND the debug
# subscriber script is running.
# NOTE: This must NOT be commented out (no # prefix) if you want it loaded.
# Leave the value empty (as below) to disable, or paste your webhook URL.
DISCORD_WEBHOOK_DEBUG=
# ── Per-asset-class signal webhooks (optional) ──────────────────────────
# If set, trade signals are routed to these channels by asset class
# instead of all going to DISCORD_WEBHOOK_SIGNALS. Leave empty to use
# the default SIGNALS webhook for all asset classes.
#   crypto   → #crypto-signals    (BTC, ETH, SOL, XRP, AVAX, WIF, LINK)
#   equities → #equities-signals  (SPY, QQQ)
#   metals   → #metals-signals    (Gold, Silver, Copper)
#   forex    → #forex-signals     (EUR/USD, GBP/USD, etc.)
DISCORD_WEBHOOK_CRYPTO=
DISCORD_WEBHOOK_EQUITIES=
DISCORD_WEBHOOK_METALS=
DISCORD_WEBHOOK_FOREX=

# ── Telegram Bot (Notifications) ──────────────────────────────────────────
# Create a bot via @BotFather, get the chat ID by messaging the bot and
# visiting https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Supabase (REQUIRED for runtime_config + pipeline persistence) ──────────
# Both values are from Supabase Dashboard → Project Settings → API.
#
# SUPABASE_URL: The project URL (e.g. https://pcvscowltlrxzgxjurcr.supabase.co)
# SUPABASE_KEY: The **service_role** key (NOT the anon/publishable key).
#   - The service role key is required because the backend reads/writes
#     nt_system_config, ta_renko_snapshot, api_keys, nt_system_config_audit,
#     nt_calibration_records, and rate_limit_violations tables.
#   - The anon/publishable key is for frontend-only use and does NOT have
#     sufficient permissions for backend operations.
#   - On Render, these must both be set or the /renko/health endpoint will
#     report "SUPABASE_URL/KEY not configured" and runtime_config will
#     fall back to env vars + hardcoded defaults.
#
# ⚠️  IMPORTANT: There is NO "SUPABASE_PUBLISHABLE_KEY" env var in the backend.
#     The backend uses SUPABASE_KEY (service role). The frontend uses
#     NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_KEY=

# Lightning & TIMESFM
# DEPRECATED — LIGHTNING_APIKEY / LIGHTNING_USER_ID / LIGHTNING_URL have no
# code consumers (verified 2026-08-12 audit M6). The studio runtime is
# configured via the LightningAI UI, not these env vars.
# LIGHTNING_APIKEY=
# LIGHTNING_USER_ID=
# LIGHTNING_URL=
TIMESFM_INFERENCE_URL=
TIMESFM_API_KEYS=
# Optional: override the direct-to-TimesFM URL used as a fallback when
# the gateway (port 8000) is unreachable. Default: http://127.0.0.1:8002/forecast
# TIMESFM_DIRECT_URL=http://127.0.0.1:8002/forecast
# Optional: disable the direct-port fallback (only use the gateway URL)
# TIMESFM_DISABLE_FALLBACK=0
# Optional: how long (seconds) start.sh / on_start.sh / background.py
# waits for the TimesFM model to finish loading before starting the
# sweep orchestrator anyway. Default: 180s. First-ever run may need 300s+
# (HuggingFace weight download). Subsequent runs: 30-60s.
# TIMESFM_READY_TIMEOUT=180

# ── Signal Qualification Thresholds ─────────────────────────────────────
# These control which sweep signals qualify for direct Discord delivery.
# Tune to control signal volume vs. quality.
#
# Gate 1: signal must be "buy" or "sell" (not "neutral") — not configurable
# Gate 2: HMM regime confidence must be >= this (default: 0.60)
# MIN_REGIME_CONF=0.60
# Gate 3: Kelly fraction must be >= this (default: 0.02 = 2%)
# MIN_KELLY=0.02
# Gate 4: TimesFM must be available (p_timesfm is not None) — not configurable
# Gate 5: TimesFM confidence |p - 0.5| must be >= this (default: 0.05 = 5%)
# MIN_TIMESFM_CONFIDENCE=0.05
# How Gate 5 is applied (default: hard):
#   hard = reject signal if confidence < MIN_TIMESFM_CONFIDENCE (binary veto)
#   soft = reduce TimesFM's blend weight proportionally to confidence,
#          don't reject. Preserves the blended EV philosophy: one uncertain
#          source contributes less but doesn't veto the signal.
#   off  = no TimesFM gate at all (rely entirely on the blended EV)
# TIMESFM_GATE_MODE=hard
# Gate 6: EV engine allow/deny — EV must be > MIN_EV AND RR must be >= MIN_RR
#   EV = (p_win * profit) - ((1 - p_win) * stake)
#   RR = tp_bricks / sl_bricks (default bricks: 5/3 = 1.67)
#   ⚠ With default brick params (sl=3, tp=5), RR=1.67 < 2.0 → ALL signals
#     are rejected by Gate 6. Either lower MIN_RR to 1.5, or increase
#     tp_bricks to 6+ in the per-symbol brick_params config.
# MIN_EV=0.0
# MIN_RR=2.0
#
# When True, sweep ALL symbols regardless of market hours. Useful for
# regime tracking outside market hours or testing on weekends. Default:
# false (stocks/commodities are skipped when the market is closed, matching
# the TS edge function behavior).
# SWEEP_AFTER_HOURS=0

# Signal Cooldown + p_win Threshold (anti-spam) ────────────────────────
# After a qualified signal is published for a (symbol, direction) pair,
# suppress subsequent signals for the same pair until the cooldown expires.
# This prevents the same BUY/SELL from being published every 5 minutes.
# Set to 0 to disable. Recommended: 60 (1 hour).
# SIGNAL_COOLDOWN_MINUTES=60
# Require the blended p_win (from the EV engine) to be above this value.
# This is a DYNAMIC quality filter — unlike MIN_RR which is static per
# symbol, p_win changes sweep-to-sweep. Set to 0.0 to disable.
# Recommended: 0.55
# MIN_P_WIN=0.55

# ── EOD Calibration Raw-Bias Thresholds (4h intraday correction) ──────
# Used ONLY by the 4h intraday correction pass (run_eod_correction(raw_bias_mode=True)).
# The raw p_win (predicted_p_win_raw, pre-enforcement Bayesian shrink) is
# naturally more extreme than the enforced value — raw model output ranges
# 0.0–1.0, while enforced values converge toward 0.5 under penalty. These
# wider thresholds prevent over-triggering on normal model variance while
# still catching true miscalibration. The user's target bias band is
# -0.2 < bias < 0.7; these are the classification boundaries within it.
#
# bias >= 0.30 → OVERCONFIDENT (raw model systematically above true win rate)
# bias <= -0.20 → UNDERCONFIDENT (raw model systematically below)
# -0.20 < bias < 0.30 → CALIBRATED
# EOD_BIAS_RAW_OVERCONFIDENT=0.30
# EOD_BIAS_RAW_UNDERCONFIDENT=-0.20

# ── TimesFM Forecast → Probability Mapping ───────────────────────────────
# The TimesFM point forecast (a price) is converted to p(up-move) via:
#   p_timesfm = sigmoid(k * relative_price_change)
# where k controls how aggressively price deltas map to confidence.
#
# k=20 (default): 1% move → p=0.73, 5% move → p=0.99 (EXCESSIVELY aggressive)
# k=10:           1% move → p=0.62, 5% move → p=0.92 (more reasonable)
# k=5:            1% move → p=0.55, 5% move → p=0.99 (conservative)
#
# The high k=20 was found to systematically produce near-1.0 p_win values,
# causing chronic OVERCONFIDENT bias across all symbols (verified 2026-08-13).
# Recommended: k=10 for production, k=5 for conservative mode.
# TIMESFM_SIGMOID_K=20.0

# Clamp range for p_timesfm — prevents extreme certainty from a single
# source dominating the logit-pooled blend. Defaults [0.001, 0.999] were
# too permissive — a 5% forecast at k=20 produced p=0.993, effectively
# bypassing downstream calibration. Recommended: [0.05, 0.95].
# TIMESFM_CLAMP_MIN=0.001
# TIMESFM_CLAMP_MAX=0.999

# ── Heavy Sweep Grid Search Filters ────────────────────────────────────────
# These thresholds are used by pick_best_combo() in heavy_sweep.py to select
# the best brick-size/SL/TP combination. MIN_RR is SHARED with the orchestrator's
# qualification gate (Gate 6b) via the same env var — when you set MIN_RR=1.5
# for signal qualification, the grid search uses the same 1.5 threshold.
# MAX_SHARPE rejects absurd outlier backtests (likely overfit).
# MIN_TRADES sets the minimum sample size for statistical validity.
# HEAVY_SWEEP_MAX_SHARPE=10.0
# HEAVY_SWEEP_MIN_TRADES=10

# ── Deployment Environment ──────────────────────────────────────────────────
# Controls production/staging hardening. MUST be set explicitly in every real
# deployment — auth hardening (C1) is FAIL-CLOSED: AUTH_MODE=disabled /
# AUTH_ENABLED=false only mint dev credentials when DEPLOY_ENV is explicitly
# 'development' or 'test'. An unset DEPLOY_ENV denies dev auth entirely.
# When "production" or "staging": a CORS wildcard ("*") is FATAL (startup
# refuses to boot) and 500s are not echoed to clients.
# Ref: main.py (os.getenv("DEPLOY_ENV", os.getenv("NODE_ENV", "development")))
#       + regime_platform/auth/auth_config.py is_dev_auth_allowed()
DEPLOY_ENV=production

# ── Service URLs / Ports (internal wiring) ──────────────────────────────────
# Base URL of THIS backend service (used for self-links / callback assembly).
# MAIN_URL=http://localhost:8000
# TimesFM inference service URL (signal forecasting). Falls back to the
# gateway (port 8000) when unreachable if TIMESFM_DISABLE_FALLBACK is unset.
# TIMESFM_SERVICE_URL=http://127.0.0.1:8002/forecast
# Port the sweep orchestrator listens on (health-check endpoint).
# Default 8003 — matches regime_platform/sweep_orchestrator/__main__.py.
# SWEEP_ORCHESTRATOR_PORT=8003

# ── Runtime Config / Markov Tuning ─────────────────────────────────────────
# TTL (seconds) for cached runtime_config lookups from Supabase.
# RUNTIME_CONFIG_TTL=60
# Paper book (M4): max age in days for an open paper position before the
# reconcile close pass force-expires it at $0 (default 30).
# NOBLE_PAPER_OPEN_MAX_AGE_DAYS=30
# Base notional used by the paper book Kelly sizing (default 1000).
# NOBLE_PAPER_BASE_NOTIONAL=1000
# Markov-regime model tuning (the ACTUAL env vars consumed by
# regime_platform/sweep_orchestrator/orchestrator.py — the old documented
# MARKOV_ALPHA/BETA/GAMMA/DELTA had zero consumers and were removed):
# Markov window over which regime features are computed (days).
# MARKOV_WINDOW_DAYS=7
# Bars per day in the Markov window (24h 1-bar → 24).
# MARKOV_BARS_PER_DAY=24
# Explicit window override in bars (defaults to WINDOW_DAYS × BARS_PER_DAY).
# MARKOV_WINDOW_BARS=168
# Hold steps used by the EV engine when simulating TP/SL paths.
# MARKOV_HOLD_STEPS=10

# ── TimesFM Signal Gate ────────────────────────────────────────────────────
# Gate 5 blend mode: hard (veto) | soft (weight down, DEFAULT) | off (no gate).
# TIMESFM_GATE_MODE=soft
# Require TimesFM to be available for a signal to pass — makes a TimesFM
# outage FATAL at startup. Read by code as TIMESFM_REQUIRED (default 0).
# TIMESFM_REQUIRED=0
# Disable the direct-to-TimesFM port fallback (use only the gateway URL).
# TIMESFM_DISABLE_FALLBACK=0
|
# ── LightningAI Studio Deployment Notes ─────────────────────────────────────
# IMPORTANT: On LightningAI Studio, env vars must be set as Studio Secrets
# (Settings → Environment → Secrets), NOT via .env.local. The .env.local
# file is NOT loaded by the Studio runtime — only local dev uses it.
#|
# Studio Secrets (set these in the Studio UI):
#   MIN_RR=1.5        # MUST be a secret (overrides signal qualification + heavy sweep grid)
#   DEBUG_SIGNALS=0   # MUST be a secret (debug signal publishing)
#   TIMESFM_SIGMOID_K=10.0     # k for p_timesfm sigmoid (1%→0.62, vs 0.73 at default k=20)
#   TIMESFM_CLAMP_MIN=0.05     # floor for p_timesfm (was 0.001 — too permissive)
#   TIMESFM_CLAMP_MAX=0.95     # ceiling for p_timesfm (was 0.999 — allowed p=1.0)
#   HEAVY_SWEEP_MAX_SHARPE=5.0 # tighter outlier rejection for emergency sweeps
#   HEAVY_SWEEP_MIN_TRADES=5   # lower sample requirement for emergency re-optimization
#|
# Non-secret env vars also need to be set in Studio Environment (not just .env.local):
#   MIN_REGIME_CONF=0.60
#   MIN_KELLY=0.02
#   MIN_TIMESFM_CONFIDENCE=0.05
#   MIN_EV=0.0
#   MIN_P_WIN=0.55
#   TIMESFM_GATE_MODE=soft
#   SIGNAL_COOLDOWN_MINUTES=60
#|
# Verified startup line (2026-08-18 01:03:22 UTC):
# Qualification thresholds: MIN_REGIME_CONF=0.6, MIN_KELLY=0.02,
#   MIN_TIMESFM_CONFIDENCE=0.05, TIMESFM_GATE_MODE=soft, MIN_EV=0.0,
#   MIN_RR=1.5, MIN_P_WIN=0.55, SIGNAL_COOLDOWN_MINUTES=60.0,
#   DEBUG_SIGNALS=False, TIMESFM_SIGMOID_K=10.0, TIMESFM_CLAMP=[0.05, 0.95]
